{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.toolocean.co" }],
      "destination": "https://toolocean.co/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "toolocean.vercel.app" }],
      "destination": "https://toolocean.co/$1",
      "permanent": true
    },
    { "source": "/csv-converter", "destination": "/csv-to-json", "permanent": true },
    { "source": "/csv-json-converter", "destination": "/csv-to-json", "permanent": true },
    { "source": "/tools/csv-json-converter", "destination": "/csv-to-json", "permanent": true },
    { "source": "/csv-tools/csv-converter", "destination": "/csv-to-json", "permanent": true },
    { "source": "/tools/csv-converter", "destination": "/csv-to-json", "permanent": true },
    { "source": "/json-csv", "destination": "/json-to-csv", "permanent": true },
    { "source": "/converter-tools/json-csv", "destination": "/json-to-csv", "permanent": true },
    { "source": "/yaml-json-converter", "destination": "/yaml-to-json", "permanent": true },
    { "source": "/tools/yaml-json-converter", "destination": "/yaml-to-json", "permanent": true },
    { "source": "/json-yaml", "destination": "/json-to-yaml", "permanent": true },
    { "source": "/converter-tools/json-yaml", "destination": "/json-to-yaml", "permanent": true },
    { "source": "/xml-json-converter", "destination": "/xml-to-json", "permanent": true },
    { "source": "/tools/xml-json-converter", "destination": "/xml-to-json", "permanent": true },
    { "source": "/json-xml", "destination": "/json-to-xml", "permanent": true },
    { "source": "/converter-tools/json-xml", "destination": "/json-to-xml", "permanent": true },
    { "source": "/json-toml", "destination": "/json-to-toml", "permanent": true },
    { "source": "/converter-tools/json-toml", "destination": "/json-to-toml", "permanent": true },
    { "source": "/tools/json-toml", "destination": "/json-to-toml", "permanent": true },
    { "source": "/tools/:slug", "destination": "/:slug", "permanent": true },
    { "source": "/pdf-tools/:slug", "destination": "/:slug", "permanent": true },
    { "source": "/csv-tools/:slug", "destination": "/:slug", "permanent": true },
    { "source": "/audio-tools/:slug", "destination": "/:slug", "permanent": true },
    { "source": "/image-tools/:slug", "destination": "/:slug", "permanent": true },
    { "source": "/video-tools/:slug", "destination": "/:slug", "permanent": true },
    { "source": "/spreadsheet-tools/:slug", "destination": "/:slug", "permanent": true },
    { "source": "/compression-tools/:slug", "destination": "/:slug", "permanent": true },
    { "source": "/archive-tools/:slug", "destination": "/:slug", "permanent": true },
    { "source": "/converter-tools/:slug", "destination": "/:slug", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
