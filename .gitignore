# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
# Intermediate SSR bundle used only by scripts/prerender.mjs
dist-ssg
*.local

# Generated by scripts/generate-sitemap.mjs on every build. Tracking it meant a
# dirty working tree after each build and a meaningless diff in every commit.
public/sitemap.xml

# Last IndexNow submission, keyed by URL. Local to whoever runs npm run indexnow.
.indexnow-state.json

# Local env files. .env.example is committed as the template; the GA measurement
# ID is not a secret (it ships in the client bundle) but the file still stays out
# of git so a fork does not inherit someone else's analytics property.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code scratch worktrees
.claude/worktrees/
