# Copy to .env for local use, and set the same variable in your host's
# environment (Vercel: Project → Settings → Environment Variables).
#
# GA4 measurement ID. Leave it unset and analytics disables itself completely:
# every call in src/lib/analytics.ts no-ops and the consent banner never renders.
# That is the intended state for `npm run dev`, so local development does not
# pollute the production property.
#
# Vite only exposes variables prefixed with VITE_ to client code, and this value
# is inlined at build time — so the host must have it set when the build runs, not
# just at runtime.
VITE_GA_MEASUREMENT_ID=
